{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "تبادل",
  "version": "1.0.0",
  "identifier": "com.tabadul.desktop",
  "build": {
    "frontendDist": "https://app.yourapp.com"
  },
  "app": {
    "windows": [
      {
        "title": "تبادل",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "url": "https://app.yourapp.com"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
