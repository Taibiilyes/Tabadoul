# قاعدة البيانات
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=changeme
DATABASE_NAME=tabadul

# لا تفعّل DB_SYNCHRONIZE في الإنتاج؛ استخدم `npm run migration:run` بدلًا منه.
DB_SYNCHRONIZE=false
DB_MIGRATIONS_RUN=false

# JWT
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# البريد الإلكتروني للتطبيق (استخدم مزود SMTP حقيقي مثل Zoho/Google Workspace)
SMTP_HOST=smtp.zoho.com
SMTP_PORT=587
SMTP_USER=support@yourapp.com
SMTP_PASSWORD=changeme
APP_SUPPORT_EMAIL=support@yourapp.com

# التخزين السحابي (لصور الهوية والوثائق - يجب تفعيل التشفير على مستوى الـ bucket)
STORAGE_BUCKET=tabadul-kyc-documents
STORAGE_REGION=eu-west-1
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# بوابة الدفع المرخّصة (استبدل هذا بمزود حقيقي مرخّص - Chargily/CIB/Stripe)
# لا تستخدم أبدًا محفظة شخصية لتحصيل الأموال مباشرة
PAYMENT_PROVIDER=chargily
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=

# إعدادات عامة
NODE_ENV=development
PORT=3000
# في الإنتاج، ضع نطاقات الواجهة ولوحة المسير فقط، مفصولة بفواصل.
CORS_ORIGIN=http://localhost:3000,http://localhost:3001
MIN_AGE=18
SIGNUP_BONUS_COINS=10
FREE_CALL_ON_FIRST_VERIFIED=true
CALL_COST_PER_60S=25
ROOM_CREATION_COST=100
